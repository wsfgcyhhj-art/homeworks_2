from abc import ABC, abstractmethod

class Hero(ABC):
    def __init__(self, name: str, level: int, health: int, strength: int):
        self.name = name
        self.level = level
        self.__health = health
        self.strength = strength

    def greet(self):
        print(f"Привет, я {self.name}, мой уровень {self.level}")

    def rest(self):
        print(f"{self.name} отдыхает")
        self.__health += 1

    @abstractmethod
    def attack(self):
        pass

class Warrior(Hero):
    def attack(self):
        print("Воин атакует мечом")

class Mage(Hero):
    def attack(self):
        print("Маг использует магию")

class Assassin(Hero):
    def attack(self):
        print("Ассасин атакует из-под тишка")

warrior = Warrior(name="Артур", level=5, health=100, strength=15)
mage = Mage(name="Гэндальф", level=10, health=70, strength=20)
assassin = Assassin(name="Эцио", level=7, health=80, strength=12)

heroes = [warrior, mage, assassin]

for hero in heroes:
    hero.greet()
    hero.attack()
    hero.rest()
    print()